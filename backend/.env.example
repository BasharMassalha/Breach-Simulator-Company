NODE_ENV=development
PORT=4000

# Use ONE of these approaches:
# (A) DATABASE_URL (recommended)
DATABASE_URL=postgres://postgres:password@localhost:5432/breach_simulator_company
# (B) Individual PG settings (optional; used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=breach_simulator_company
PGUSER=postgres
PGPASSWORD=postgres

# JWT settings (development only)
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m

